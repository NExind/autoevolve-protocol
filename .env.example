# Model provider (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional: embeds only safe memory cards before pinning. Leave false for a
# no-network deterministic memory path.
MEMORY_EMBEDDINGS_ENABLED=false

# IPFS / Pinata (server-side only)
PINATA_JWT=
PINATA_GATEWAY=

# Base Sepolia deployment and reads
BASE_SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_EXPLORER_BASE_URL=https://sepolia.basescan.org

# Contract deployment scripts (all values are local-only)
GENERATED_VERIFIER_ADDRESS=
GENERATED_VERIFIER_SOURCE=generated/GeneratedGroth16Verifier.sol
GENERATED_VERIFIER_CONTRACT_NAME=Groth16Verifier
REGISTRY_ADDRESS=
REGISTRY_REWARD_WEI=100000000000000
ESCROW_FUND_WEI=200000000000000

# Optional: verify source after deployment
BASESCAN_API_KEY=
