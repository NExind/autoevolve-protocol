# ==============================================================================
# AutoEvolve Protocol Environment Configuration
# ==============================================================================
# NOTE: Zero API keys are required to run the deterministic showcase replay!
# Simply run `pnpm install` and `pnpm dev` to explore the complete dashboard.
# Configure the keys below to enable live multi-model evolution, IPFS pinning,
# or Base Sepolia smart contract interactions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM Model Providers (Server-Side Only)
# ------------------------------------------------------------------------------
# Option A: Featherless (Open-source LLM inference for generator & critic)
# When present, Featherless powers Qwen-2.5-Coder policy generation & adversarial critique.
FEATHERLESS_API_KEY=
FEATHERLESS_GENERATOR_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
FEATHERLESS_CRITIC_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-32B

# Option B: Google Gemini
# Used for live Gemini policy generation and AI Critic audits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional: embeds only safe memory cards before pinning. Leave false for a
# no-network deterministic memory path.
MEMORY_EMBEDDINGS_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Decentralized IPFS Storage / Pinata (Server-Side Only)
# ------------------------------------------------------------------------------
# Required only for pinning live sanitized SnapshotCore memory files to IPFS.
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# ------------------------------------------------------------------------------
# 3. Base Sepolia EVM Testnet (Chain ID: 84532)
# ------------------------------------------------------------------------------
# Verified deployed registry and verifier contracts on Base Sepolia.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x24473c0043b13d56874d10de9675728e2014a66c
NEXT_PUBLIC_EXPLORER_BASE_URL=https://sepolia.basescan.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Private keys for local deployment and on-chain settlement scripts
DEPLOYER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. Smart Contract Deployment & Verification (Scripts Only)
# ------------------------------------------------------------------------------
GENERATED_VERIFIER_ADDRESS=0x7c32dcfcaaae6bdcc6f5d2daa61b7e91629aa764
GENERATED_VERIFIER_SOURCE=generated/GeneratedGroth16Verifier.sol
GENERATED_VERIFIER_CONTRACT_NAME=Groth16Verifier
REGISTRY_ADDRESS=0x24473c0043b13d56874d10de9675728e2014a66c
REGISTRY_REWARD_WEI=100000000000000
ESCROW_FUND_WEI=200000000000000

# Optional: BaseScan API key for verifying contracts
BASESCAN_API_KEY=
